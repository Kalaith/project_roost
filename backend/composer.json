{
    "name": "webhatchery/project-roost-backend",
    "description": "Project Roost portfolio registry API",
    "type": "project",
    "require": {
        "php": "^8.1",
        "firebase/php-jwt": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0
    },
    "scripts": {
        "start": "php -S localhost:8000 public/index.php",
        "db:init": "php bin/db-init.php",
        "seed:export": "php bin/export-seed-sql.php",
        "init:export": "php bin/export-init-sql.php",
        "test": "php ../../../vendor/bin/phpunit -c phpunit.xml",
        "cs-check": "php -l public/index.php",
        "cs-fix": "@cs-check"
    }
}
